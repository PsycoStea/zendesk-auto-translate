{
  "manifest_version": 3,
  "name": "Zendesk Auto Translator",
  "version": "1.0.46",
  "description": "Automatically translate Zendesk customer messages to English and replies back to customer language",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.zendesk.com/*",
    "https://translate.googleapis.com/*",
    "https://*.zdusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.zendesk.com/*"],
      "js": ["src/translate-core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "translate-reply": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Translate the current reply to the customer's language"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdfjs/web/viewer.html",
        "lib/pdfjs/web/viewer.css",
        "lib/pdfjs/web/viewer.mjs",
        "lib/pdfjs/web/images/*",
        "lib/pdfjs/web/locale/*",
        "lib/pdfjs/web/cmaps/*",
        "lib/pdfjs/web/standard_fonts/*",
        "lib/pdfjs/web/wasm/*",
        "lib/pdfjs/web/iccs/*",
        "lib/pdfjs/build/pdf.mjs",
        "lib/pdfjs/build/pdf.worker.mjs",
        "lib/pdfjs/build/pdf.sandbox.mjs"
      ],
      "matches": ["https://*.zendesk.com/*"]
    }
  ]
}
